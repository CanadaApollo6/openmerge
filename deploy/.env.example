# Copy to deploy/.env, chmod 600, then replace every placeholder.
# Use a URL-safe password, e.g. openssl rand -hex 24.
OPENMERGE_POSTGRES_PASSWORD=replace-with-random-hex
OPENMERGE_GITHUB_APP_ID=123
OPENMERGE_GITHUB_INSTALLATION_ID=456
# Absolute path to an existing RSA PEM, readable by container UID 1000.
OPENMERGE_GITHUB_PRIVATE_KEY_PATH=/home/you/.config/openmerge/app/private-key.pem
OPENMERGE_REPOS=owner/repository
OPENMERGE_BASE=main
# Optional bearer token; leave empty for unauthenticated localhost reads.
OPENMERGE_API_TOKEN=
OPENMERGE_LOG_LEVEL=info
